# Copy this file to .env and fill in real values. .env is gitignored.

# MongoDB connection string — local or Atlas, e.g.:
# MONGO_URI=mongodb://127.0.0.1:27017/fakeazon
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URI=mongodb://127.0.0.1:27017/fakeazon

# Secret used to sign JWTs (Experiment 7). Use a long random string in any
# real deployment — this placeholder is fine for local dev only.
JWT_SECRET=fakeazon-lab-dev-secret-change-me

# Deployed frontend URL, allowed by CORS in addition to localhost:5173
# (Experiment 9). Leave blank for local-only dev.
FRONTEND_URL=

PORT=5050
